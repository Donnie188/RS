# ============================================================
# 使用方式：把本文件复制一份，改名为 .env，填入你的 Key 即可
#   cp .env.example .env        （Windows: copy .env.example .env）
# 注意：.env 已在 .gitignore 中排除，不会误传密钥到 GitHub
# ============================================================

# ---------- 对话模型（生成答案用） ----------
# 可选：deepseek / moonshot / dashscope / zhipu / openai / local
LLM_PROVIDER=deepseek

# 你的 API Key。留空则脚本自动进入"本地降级模式"，仍能演示检索链路
LLM_API_KEY=

# 下面三项留空时，会自动使用 PROVIDER_PRESETS 里对应供应商的默认值
LLM_BASE_URL=
LLM_MODEL=

# ---------- 向量模型（Embedding，可单独换一家） ----------
# 留空则跟随 LLM_PROVIDER。很多对话供应商（如 DeepSeek）不提供 Embedding 接口，
# 此时脚本会自动降级为本地哈希向量，功能可用但无语义泛化能力。
EMBED_PROVIDER=
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=

# 向量维度：必须与模型实际输出一致。改动后必须删除 index/ 目录重建索引
EMBED_DIM=1024

# ---------- 检索参数 ----------
CHUNK_SIZE=500          # 切片字数
CHUNK_OVERLAP=80        # 切片重叠字数
TOP_K=3                 # 混合检索召回条数
