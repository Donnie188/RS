# ============================================================
# 复制本文件为 .env 后填写。全部留空也能跑（问答走降级模式，检索走本地哈希向量）
# ============================================================

# ---- JWT 鉴权（生产环境必须改掉默认值）----
JWT_SECRET=change-me-in-production
TOKEN_EXPIRE_HOURS=12

# ---- 大模型供应商：deepseek / moonshot / dashscope / zhipu / openai ----
LLM_PROVIDER=deepseek
LLM_API_KEY=
# 以下两项留空则自动使用供应商预设值
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1

# ---- Embedding 供应商（可与 LLM 不同；DeepSeek 无 embedding 接口）----
# 留空 EMBED_PROVIDER = 本地哈希向量降级（仅字面相似，够演示检索链路）
EMBED_PROVIDER=dashscope
EMBED_API_KEY=
# EMBED_MODEL=text-embedding-v3
# EMBED_DIM=1024

# ---- 检索参数（一般不用改）----
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=3
