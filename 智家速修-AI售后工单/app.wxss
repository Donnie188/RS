/* app.wxss — 全局样式，紫色 AI 主题 */
page {
  background: #F5F3FF;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: #1E293B;
}
.card {
  background: #fff; border-radius: 20rpx; padding: 32rpx;
  margin: 20rpx 24rpx; box-shadow: 0 4rpx 16rpx rgba(124,58,237,0.06);
}
.btn-primary {
  background: #7C3AED; color: #fff; border-radius: 48rpx;
  font-size: 32rpx; font-weight: 600;
}
.btn-primary::after { border: none; }
.tag {
  display: inline-block; font-size: 22rpx; padding: 4rpx 16rpx;
  border-radius: 8rpx; margin-right: 12rpx;
}
.tag-purple { background: #EDE9FE; color: #6D28D9; }
.tag-green { background: #D1FAE5; color: #047857; }
.tag-orange { background: #FFEDD5; color: #C2410C; }
.tag-red { background: #FEE2E2; color: #B91C1C; }
.tag-gray { background: #F1F5F9; color: #475569; }
.muted { color: #64748B; font-size: 24rpx; }
.title { font-size: 34rpx; font-weight: 700; color: #0F172A; }
.ai-badge {
  display: inline-block; background: #EDE9FE; color: #6D28D9;
  font-size: 20rpx; font-weight: 700; padding: 2rpx 12rpx;
  border-radius: 6rpx; margin-left: 10rpx;
}
