# ============================================================
# 复制本文件为 .env 后填写。全部留空也能跑（问答走降级模式，检索走本地哈希向量）
# ============================================================

# ---- JWT 鉴权（生产环境必须改掉默认值）----
JWT_SECRET=change-me-in-production
TOKEN_EXPIRE_HOURS=12

# ---- 大模型供应商：deepseek / moonshot / dashscope / zhipu / openai ----
LLM_PROVIDER=deepseek
LLM_API_KEY=
# 以下两项留空则自动使用供应商预设值
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com/v1

# ---- Embedding 供应商（可与 LLM 不同；DeepSeek 无 embedding 接口）----
# 留空 EMBED_PROVIDER = 本地哈希向量降级（仅字面相似，够演示检索链路）
EMBED_PROVIDER=dashscope
EMBED_API_KEY=
# EMBED_MODEL=text-embedding-v3
# EMBED_DIM=1024

# ---- 检索参数（一般不用改）----
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=3

# ---- 阶段 7 上线加固（可选，留空用默认值）----
# 问答限流：每人每分钟最多发起次数（LLM 配额保护）
CHAT_RATE_LIMIT_PER_MIN=60
# 日志保留天数（scripts/purge_logs.py 按此清理；被标记的审计记录永久保留）
LOG_RETENTION_DAYS=90
# 数据库备份保留份数（scripts/backup_db.py）
BACKUP_KEEP=7
